---
/**
 * Spryte/Nemo-style gateway CTAs: free product first, then human consult.
 * Primary = Run a free audit (Spryte) · Secondary = Free visibility score (Nemo) · Tertiary = Book a free consult
 */
import JellyButton from './JellyButton.astro';
import { gatewayCtas } from '../data/value-offers';
import { withBase } from '../lib/url';

interface Props {
  size?: 'sm' | 'md';
  /** full = audit + score + consult · products = audit + score · pair = audit + consult */
  layout?: 'full' | 'products' | 'pair';
  class?: string;
  /** Emphasize primary with eyebrow on the audit button */
  emphasize?: boolean;
}

const {
  size = 'md',
  layout = 'full',
  class: className,
  emphasize = false,
} = Astro.props;

const showScore = layout === 'full' || layout === 'products';
const showConsult = layout === 'full' || layout === 'pair';
---

<div class:list={['flex flex-wrap items-center gap-4', className]}>
  <JellyButton
    href={gatewayCtas.audit.href}
    size={size}
    label={gatewayCtas.audit.label}
    eyebrow={emphasize ? 'Free · no card' : undefined}
    external
  />
  {
    showScore && (
      <JellyButton
        href={gatewayCtas.score.href}
        variant="ghost"
        size={size}
        label={gatewayCtas.score.label}
        external
      />
    )
  }
  {
    showConsult && (
      <JellyButton
        href={withBase(gatewayCtas.consult.href)}
        variant="ghost"
        size={size}
        label={gatewayCtas.consult.label}
      />
    )
  }
</div>
