---
/**
 * Site-wide visit counter (once per browser session).
 * Backed by CountAPI — no signup/keys; public key only.
 * https://countapi.mileshilliard.com/
 */
const COUNTER_KEY = 'sentientsprite-portfolio-site-visits';
---

<div
  class="visit-counter group inline-flex items-center gap-2.5 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3.5 py-1.5 text-xs shadow-[0_0_24px_-8px_rgba(16,185,129,0.45)] ring-1 ring-emerald-400/10 transition hover:border-emerald-400/40 hover:bg-emerald-500/15"
  data-visit-counter
  data-counter-key={COUNTER_KEY}
  aria-live="polite"
  title="Total unique-ish visits (counts once per browser session)"
>
  <span
    class="grid h-5 w-5 place-items-center rounded-full bg-emerald-500/20 text-[10px] text-emerald-300 ring-1 ring-emerald-400/30"
    aria-hidden="true"
  >
    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
  </span>
  <span class="flex items-baseline gap-1.5 text-neutral-400">
    <span class="font-semibold tabular-nums tracking-tight text-emerald-300" data-visit-count>—</span>
    <span class="text-neutral-500">curious humans</span>
    <span class="hidden text-neutral-600 sm:inline">have peeked in</span>
  </span>
  <span
    class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400/80 shadow-[0_0_8px_rgba(52,211,153,0.9)]"
    aria-hidden="true"
  ></span>
</div>

<script>
  const ENDPOINT = 'https://countapi.mileshilliard.com/api/v1';
  const SESSION_FLAG = 'rk-visit-counted';

  function formatCount(n: number) {
    return new Intl.NumberFormat('en-US').format(n);
  }

  async function fetchJson(url: string) {
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) throw new Error(`counter ${res.status}`);
    return res.json() as Promise<{ value?: number | string }>;
  }

  function parseValue(data: { value?: number | string } | null) {
    const raw = data?.value;
    const n = typeof raw === 'number' ? raw : Number(raw);
    return Number.isFinite(n) ? n : null;
  }

  async function loadCounter(el: HTMLElement) {
    const key = el.dataset.counterKey;
    const countEl = el.querySelector<HTMLElement>('[data-visit-count]');
    if (!key || !countEl) return;

    try {
      const already = sessionStorage.getItem(SESSION_FLAG) === '1';
      const data = already
        ? await fetchJson(`${ENDPOINT}/get/${encodeURIComponent(key)}`)
        : await fetchJson(`${ENDPOINT}/hit/${encodeURIComponent(key)}`);

      if (!already) sessionStorage.setItem(SESSION_FLAG, '1');

      const value = parseValue(data);
      if (value === null) return;
      countEl.textContent = formatCount(value);
    } catch {
      // Keep em dash if the counter is unreachable
    }
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-visit-counter]').forEach((el) => {
      if (el.dataset.bound === '1') return;
      el.dataset.bound = '1';
      void loadCounter(el);
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
