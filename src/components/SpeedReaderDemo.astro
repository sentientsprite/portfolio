---
/**
 * Inline paste-and-play Spritz demo for the Speed Reader work page.
 */
import JellyButton from './JellyButton.astro';

const sample = `Paste any article, email, or notes into the box and hit Play. The reader flashes one word at a time with the optimal recognition letter highlighted in green — the same Spritz-style engine that powers the blue speed-read button on every page of this site. Adjust words per minute until it feels comfortable, pause anytime, then try your own text.`;
const githubZip = 'https://github.com/sentientsprite/speed-reader/archive/refs/heads/main.zip';
const githubRepo = 'https://github.com/sentientsprite/speed-reader';
---

<section
  id="try-speed-reader"
  class="sr-demo mt-8 overflow-hidden rounded-xl border border-emerald-500/30 bg-neutral-950 shadow-2xl"
>
  <div class="border-b border-neutral-800 bg-neutral-950/80 px-4 py-4 sm:px-5">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">Browser extension</p>
    <h2 class="mt-1 text-lg font-semibold text-neutral-100">Install once. Speed-read anywhere.</h2>
    <p class="mt-1 max-w-2xl text-sm text-neutral-500">
      Instant download from GitHub, load unpacked, then highlight text on any site and right-click
      <span class="text-neutral-300">Speed read selection</span>. Max 1500 WPM. Fully offline.
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <a
        href={githubZip}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-neutral-950 transition hover:bg-emerald-400"
      >
        Download extension (.zip)
      </a>
      <a
        href={githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-xl border border-neutral-600 px-5 py-3 text-sm font-semibold text-neutral-100 transition hover:border-emerald-500/50 hover:text-emerald-300"
      >
        GitHub repo ↗
      </a>
      <a
        href="#sr-install-steps"
        class="inline-flex items-center justify-center rounded-xl border border-neutral-700 px-5 py-3 text-sm font-medium text-neutral-300 transition hover:border-neutral-500"
      >
        Install steps ↓
      </a>
    </div>
    <ol
      id="sr-install-steps"
      class="mt-4 list-decimal space-y-1.5 rounded-xl border border-neutral-800 bg-neutral-900/50 px-5 py-4 pl-9 text-sm text-neutral-400"
    >
      <li>Download the zip (or open <code class="text-neutral-300">INSTALL.txt</code> in the repo).</li>
      <li>Unzip — open the <code class="text-neutral-300">extension</code> folder (it has <code class="text-neutral-300">manifest.json</code>).</li>
      <li>Open <code class="text-neutral-300">chrome://extensions</code> → Developer mode → <span class="text-neutral-300">Load unpacked</span> → pick <code class="text-neutral-300">extension</code>.</li>
      <li>Highlight text → right-click → <span class="text-neutral-300">Speed read selection</span> (or Alt+Shift+S).</li>
    </ol>
  </div>
</section>

<section
  class="sr-demo mt-6 overflow-hidden rounded-xl border border-neutral-800 bg-neutral-950 shadow-2xl"
  data-speed-demo
>
  <div class="border-b border-neutral-800 bg-neutral-950/80 px-4 py-3 sm:px-5">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">Live demo</p>
    <h2 class="mt-1 text-lg font-semibold text-neutral-100">Paste your text. Hit play.</h2>
    <p class="mt-1 text-sm text-neutral-500">
      Same engine as the plugin — runs entirely in your browser, nothing uploaded.
    </p>
  </div>

  <div class="grid gap-0 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="border-b border-neutral-800 p-4 sm:p-5 lg:border-b-0 lg:border-r">
      <label for="sr-demo-input" class="text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">
        Your text
      </label>
      <textarea
        id="sr-demo-input"
        class="mt-2 h-48 w-full resize-y rounded-xl border border-neutral-800 bg-neutral-900/60 px-3 py-3 text-sm leading-relaxed text-neutral-200 placeholder:text-neutral-600 focus:border-emerald-500/40 focus:outline-none focus:ring-1 focus:ring-emerald-500/30 sm:h-64"
        spellcheck="true"
        data-sr-input
      >{sample}</textarea>
      <div class="mt-3 flex flex-wrap gap-2">
        <JellyButton as="button" type="button" size="sm" label="Play" id="sr-demo-play" />
        <JellyButton as="button" type="button" variant="ghost" size="sm" label="Clear" id="sr-demo-clear" />
      </div>
    </div>

    <div class="flex flex-col p-4 sm:p-5">
      <div class="sr-demo__stage flex flex-1 flex-col justify-center rounded-xl border border-neutral-800 bg-neutral-900/40 px-3 py-6">
        <p class="sr-demo__guide mb-0 text-center font-mono text-sm text-neutral-600 select-none" aria-hidden="true">
          ―――――――――― ф ―――――――――――
        </p>
        <div
          class="sr-demo__word my-1 grid min-h-[2.6rem] grid-cols-[1fr_auto_1fr] items-center font-mono text-2xl leading-tight text-neutral-100"
          aria-live="assertive"
          aria-atomic="true"
          data-sr-word
        >
          <span class="text-right" data-sr-before></span>
          <span class="font-bold text-emerald-400" data-sr-focus>S</span>
          <span class="text-left" data-sr-after></span>
        </div>
        <p class="sr-demo__guide mb-0 text-center font-mono text-sm text-neutral-600 select-none" aria-hidden="true">
          ――――――――――――――――――――――
        </p>
        <p class="mt-3 text-center text-xs text-neutral-500" data-sr-status>Choose a WPM, then Play.</p>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <label class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500" for="sr-demo-wpm">
          WPM
        </label>
        <select
          id="sr-demo-wpm"
          class="min-w-[5.5rem] rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 focus:border-emerald-500/40 focus:outline-none"
          data-sr-wpm
        >
          <option value="200">200</option>
          <option value="250">250</option>
          <option value="300">300</option>
          <option value="350" selected>350</option>
          <option value="400">400</option>
          <option value="450">450</option>
          <option value="500">500</option>
          <option value="600">600</option>
          <option value="700">700</option>
          <option value="800">800</option>
          <option value="1000">1000</option>
          <option value="1200">1200</option>
          <option value="1500">1500</option>
        </select>
      </div>
    </div>
  </div>
</section>

<script>
  import { createSpeedReader } from '../lib/speed-reader';

  function initDemo(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = 'true';

    const input = root.querySelector('[data-sr-input]') as HTMLTextAreaElement | null;
    const playBtn = root.querySelector('#sr-demo-play') as HTMLButtonElement | null;
    const clearBtn = root.querySelector('#sr-demo-clear') as HTMLButtonElement | null;
    const wpmSelect = root.querySelector('[data-sr-wpm]') as HTMLSelectElement | null;
    const beforeEl = root.querySelector('[data-sr-before]') as HTMLElement | null;
    const focusEl = root.querySelector('[data-sr-focus]') as HTMLElement | null;
    const afterEl = root.querySelector('[data-sr-after]') as HTMLElement | null;
    const statusEl = root.querySelector('[data-sr-status]') as HTMLElement | null;

    if (!input || !playBtn || !wpmSelect || !beforeEl || !focusEl || !afterEl) return;

    const setPlayLabel = (label: string) => {
      const text = playBtn.querySelector('.jelly-btn__text');
      if (text) text.textContent = label;
      else playBtn.setAttribute('aria-label', label);
    };

    const reader = createSpeedReader({
      onWord(parts, index, total) {
        beforeEl.textContent = parts.before;
        focusEl.textContent = parts.focus;
        afterEl.textContent = parts.after;
        if (statusEl) statusEl.textContent = `Word ${index + 1} of ${total}`;
      },
      onDone() {
        setPlayLabel('Play');
        if (statusEl) statusEl.textContent = 'Finished — hit Play to restart.';
      },
      onEmpty() {
        beforeEl.textContent = '';
        focusEl.textContent = '—';
        afterEl.textContent = '';
        setPlayLabel('Play');
        if (statusEl) statusEl.textContent = 'Paste some text first.';
      },
    });

    function currentWpm() {
      return parseInt(wpmSelect.value, 10) || 350;
    }

    function resetStage() {
      beforeEl.textContent = '';
      focusEl.textContent = 'S';
      afterEl.textContent = '';
      if (statusEl) statusEl.textContent = 'Choose a WPM, then Play.';
    }

    playBtn.addEventListener('click', () => {
      if (!reader.isActive()) {
        const text = input.value.trim();
        if (!text) {
          if (statusEl) statusEl.textContent = 'Paste some text first.';
          input.focus();
          return;
        }
        reader.start(text, currentWpm());
        setPlayLabel('Pause');
        return;
      }
      if (reader.isPaused()) {
        reader.resume();
        setPlayLabel('Pause');
      } else {
        reader.pause();
        setPlayLabel('Play');
      }
    });

    clearBtn?.addEventListener('click', () => {
      reader.stop();
      input.value = '';
      setPlayLabel('Play');
      resetStage();
      input.focus();
    });

    wpmSelect.addEventListener('change', () => {
      if (reader.isActive()) reader.setWpm(currentWpm());
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-speed-demo]').forEach(initDemo);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
