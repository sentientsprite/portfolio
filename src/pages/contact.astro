---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import GrowthIntakeForm from '../components/GrowthIntakeForm.astro';
import JellyButton from '../components/JellyButton.astro';
import GatewayCTAs from '../components/GatewayCTAs.astro';
import SuggestCTA from '../components/SuggestCTA.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Contact"
  description="Start with a free Spryte audit or Nemo visibility score, then book a free consult with Raymond King if you want a human next step."
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <SectionHeading
      eyebrow="Gateway"
      title="Start free. Talk when you're ready."
      subtitle="Same pattern as Spryte and Nemo: run a free diagnostic first. The intake below is for a no-obligation consult — only if you want a human walkthrough after you've seen a score."
    />

    <div class="mt-6">
      <GatewayCTAs layout="products" size="sm" />
    </div>

    <div class="mt-10" data-animate>
      <GrowthIntakeForm showIntro={false} />
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <SuggestCTA />
    </div>

    <div
      class="glow-card mt-10 overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/40 p-8 text-center backdrop-blur-sm sm:p-10"
      data-animate
    >
      <h3 class="text-lg font-semibold text-neutral-100">Prefer to reach out directly?</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-neutral-400">Email is the fastest way to get me for project inquiries.</p>
      <JellyButton href={`mailto:${site.email}`} label={site.email} class="mt-6" />
      <div class="mt-8">
        <SocialLinks />
      </div>
    </div>
  </div>
</BaseLayout>
