---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JellyButton from '../components/JellyButton.astro';
import { consultClips } from '../data/value-offers';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Free consult roadmap"
  description="What Raymond covers on a free marketing-systems consult — agenda, prep, fit, and what happens after."
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <SectionHeading
      eyebrow="Free consult"
      title="What the call actually covers"
      subtitle="Short, readable briefs — so you know the agenda before you book. Video clips can drop in here later; the substance is already here."
    />

    <div class="mt-10 space-y-4">
      {
        consultClips.map((clip, i) => (
          <details
            class="group overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/40 open:border-emerald-500/30"
            open={i === 0}
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 sm:p-6">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-500">
                  Clip {String(i + 1).padStart(2, '0')} · {clip.duration}
                </p>
                <h2 class="mt-1 text-lg font-semibold text-neutral-100 group-open:text-emerald-300">
                  {clip.title}
                </h2>
                <p class="mt-1 text-sm text-neutral-400">{clip.summary}</p>
              </div>
              <span class="mt-1 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-neutral-700 text-emerald-400 transition group-open:rotate-45">
                +
              </span>
            </summary>
            <div class="border-t border-neutral-800 px-5 pb-5 sm:px-6 sm:pb-6">
              <div class="mt-4 aspect-video overflow-hidden rounded-xl border border-dashed border-neutral-700 bg-neutral-950/80">
                <div class="flex h-full flex-col items-center justify-center gap-2 px-6 text-center">
                  <span class="text-xs uppercase tracking-[0.2em] text-neutral-600">Recording slot</span>
                  <p class="max-w-sm text-sm text-neutral-500">
                    Drop a 60–90s clip here when ready. Until then, the transcript beats below are the source of truth.
                  </p>
                </div>
              </div>
              <ul class="mt-4 space-y-2 text-sm text-neutral-300">
                {clip.beats.map((beat) => (
                  <li class="flex gap-2">
                    <span class="text-emerald-400">→</span>
                    <span>{beat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>

    <div class="mt-12 rounded-3xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/10 via-neutral-900/40 to-neutral-950 p-8 text-center">
      <h3 class="text-xl font-semibold text-neutral-100">Ready for the hour?</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-neutral-400">
        Free and no-obligation. Tell me where leads slip — we’ll name the bottleneck and the smallest useful next step.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <JellyButton href={withBase('/contact#intake')} label="Book a free consult" />
        <JellyButton href={withBase('/pricing')} variant="ghost" label="See engagement bands" />
      </div>
    </div>
  </div>
</BaseLayout>
