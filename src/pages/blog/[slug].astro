---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JellyButton from '../../components/JellyButton.astro';
import { getAllMediumPosts } from '../../lib/medium';
import { withBase } from '../../lib/url';
import type { MediumPost } from '../../lib/medium';

export async function getStaticPaths() {
  const posts = await getAllMediumPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: MediumPost;
}

const { post } = Astro.props;

const dateFmt = post.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isSpeedReaderPost =
  post.slug === 'this-dyslexia-friendly-speed-reading-tool-has-existed-for-over-a-decade-d75d07dffbae';
const speedReaderZip = 'https://github.com/sentientsprite/speed-reader/archive/refs/heads/main.zip';
const speedReaderRepo = 'https://github.com/sentientsprite/speed-reader';
const speedReaderTry = withBase('/work/speed-reader#try-speed-reader');
---

<BaseLayout title={post.title} description={post.snippet}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <a
      href={withBase('/blog')}
      class="inline-flex items-center gap-1 text-sm text-neutral-400 transition-colors hover:text-emerald-400"
    >
      &larr; Back to Blog
    </a>

    <header class="mt-6 border-b border-neutral-800 pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500">
        <span class="font-medium text-emerald-400">Medium</span>
        <time datetime={post.pubDate.toISOString()}>{dateFmt}</time>
      </div>
      <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">
        {post.title}
      </h1>
      {
        post.categories.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {post.categories.map((tag) => (
              <span class="rounded bg-neutral-800 px-2.5 py-1 text-xs text-neutral-400">{tag}</span>
            ))}
          </div>
        )
      }
      <div class="mt-6 flex flex-wrap gap-2">
        {
          isSpeedReaderPost && (
            <>
              <a
                href={speedReaderZip}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-neutral-950 transition hover:bg-emerald-400"
              >
                Download extension
              </a>
              <a
                href={speedReaderTry}
                class="inline-flex items-center justify-center rounded-xl border border-neutral-600 px-5 py-3 text-sm font-semibold text-neutral-100 transition hover:border-emerald-500/50 hover:text-emerald-300"
              >
                Try on site →
              </a>
              <a
                href={speedReaderRepo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-xl border border-neutral-700 px-5 py-3 text-sm font-medium text-neutral-300 transition hover:border-neutral-500"
              >
                GitHub repo ↗
              </a>
            </>
          )
        }
        <JellyButton href={post.link} external size="sm" label="Read on Medium ↗" />
      </div>
    </header>

    {
      isSpeedReaderPost && (
        <div class="mt-8 rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-5 sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">
            Free browser extension
          </p>
          <h2 class="mt-1 text-lg font-semibold text-neutral-100">RK Speed Reader</h2>
          <p class="mt-1 text-sm text-neutral-400">
            Highlight any text → right-click → speed-read. Max 1500 WPM. Instant GitHub download — load
            unpacked in Chrome/Edge, then use it on any site.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a
              href={speedReaderZip}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-neutral-950 transition hover:bg-emerald-400"
            >
              Download extension (.zip)
            </a>
            <a
              href={speedReaderTry}
              class="inline-flex items-center justify-center rounded-xl border border-neutral-600 px-5 py-3 text-sm font-semibold text-neutral-100 transition hover:border-emerald-500/50 hover:text-emerald-300"
            >
              Install steps + demo →
            </a>
          </div>
        </div>
      )
    }

    {
      post.thumbnail && (
        <figure class="mt-8 overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950">
          <img
            src={post.thumbnail}
            alt=""
            class="aspect-[1200/630] w-full object-cover"
            loading="eager"
          />
        </figure>
      )
    }

    {
      post.contentHtml ? (
        <div class="prose medium-prose mt-10" set:html={post.contentHtml} />
      ) : (
        <p class="mt-10 text-neutral-400">
          Full text isn’t cached for this post yet. Read it on Medium.
        </p>
      )
    }

    <footer class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-800 pt-8">
      <a
        href={withBase('/blog')}
        class="text-sm text-neutral-400 transition-colors hover:text-emerald-400"
      >
        &larr; All posts
      </a>
      <div class="flex flex-wrap gap-2">
        {
          isSpeedReaderPost && (
            <a
              href={speedReaderZip}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-neutral-950 transition hover:bg-emerald-400"
            >
              Download extension
            </a>
          )
        }
        <JellyButton href={post.link} external size="sm" label="Open on Medium ↗" />
      </div>
    </footer>
  </article>
</BaseLayout>
