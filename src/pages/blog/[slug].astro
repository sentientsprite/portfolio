---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JellyButton from '../../components/JellyButton.astro';
import { getAllMediumPosts } from '../../lib/medium';
import { withBase } from '../../lib/url';
import type { MediumPost } from '../../lib/medium';

export async function getStaticPaths() {
  const posts = await getAllMediumPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: MediumPost;
}

const { post } = Astro.props;

const dateFmt = post.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.title} description={post.snippet}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <a
      href={withBase('/blog')}
      class="inline-flex items-center gap-1 text-sm text-neutral-400 transition-colors hover:text-emerald-400"
    >
      &larr; Back to Blog
    </a>

    <header class="mt-6 border-b border-neutral-800 pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500">
        <span class="font-medium text-emerald-400">Medium</span>
        <time datetime={post.pubDate.toISOString()}>{dateFmt}</time>
      </div>
      <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">
        {post.title}
      </h1>
      {
        post.categories.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {post.categories.map((tag) => (
              <span class="rounded bg-neutral-800 px-2.5 py-1 text-xs text-neutral-400">{tag}</span>
            ))}
          </div>
        )
      }
      <div class="mt-6">
        <JellyButton href={post.link} external size="sm" label="Read on Medium ↗" />
      </div>
    </header>

    {
      post.thumbnail && (
        <figure class="mt-8 overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950">
          <img
            src={post.thumbnail}
            alt=""
            class="aspect-[1200/630] w-full object-cover"
            loading="eager"
          />
        </figure>
      )
    }

    {
      post.contentHtml ? (
        <div class="prose medium-prose mt-10" set:html={post.contentHtml} />
      ) : (
        <p class="mt-10 text-neutral-400">
          Full text isn’t cached for this post yet. Read it on Medium.
        </p>
      )
    }

    <footer class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-800 pt-8">
      <a
        href={withBase('/blog')}
        class="text-sm text-neutral-400 transition-colors hover:text-emerald-400"
      >
        &larr; All posts
      </a>
      <JellyButton href={post.link} external size="sm" label="Open on Medium ↗" />
    </footer>
  </article>
</BaseLayout>
