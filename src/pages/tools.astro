---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ToolStackMap from '../components/ToolStackMap.astro';
import JellyButton from '../components/JellyButton.astro';
import { ownerTools, NEMO_SCORE_URL } from '../data/value-offers';
import { withBase } from '../lib/url';

const speedReaderZip = 'https://github.com/sentientsprite/speed-reader/archive/refs/heads/main.zip';
---

<BaseLayout
  title="Owner tools"
  description="Free diagnostic tools: Spryte lead audit, lead-leak checklist, module quiz, niche booking preview, local visibility score, consult roadmap, pricing bands, and the tool stack map."
>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeading
      eyebrow="Owner tools"
      title="Useful before you hire anyone"
      subtitle="Self-serve diagnostics and demos — find where leads slip, which module fits, what a consult covers, and try Nemo or Spryte when you want a live score. Nothing here requires a sales call."
    />

    <div class="mt-8 flex flex-col gap-4 rounded-2xl border border-emerald-500/25 bg-emerald-500/5 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">Free browser extension</p>
        <h2 class="mt-1 text-lg font-semibold text-neutral-100">RK Speed Reader</h2>
        <p class="mt-1 text-sm text-neutral-400">
          Highlight any text → right-click → speed-read. Max 1500 WPM. Instant GitHub download.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <JellyButton href={speedReaderZip} external size="sm" label="Download extension" />
        <JellyButton href={withBase('/work/speed-reader#try-speed-reader')} variant="ghost" size="sm" label="How to install →" />
      </div>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        ownerTools.map((card) => (
          <a
            href={card.external ? card.href : withBase(card.href)}
            target={card.external ? '_blank' : undefined}
            rel={card.external ? 'noopener noreferrer' : undefined}
            class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition hover:border-emerald-500/40"
          >
            <h2 class="text-base font-semibold text-neutral-100 group-hover:text-emerald-300">{card.title}</h2>
            <p class="mt-2 text-sm text-neutral-400">{card.body}</p>
            <span class="mt-3 inline-block text-xs font-medium text-emerald-400">
              {card.external ? 'Open ↗' : 'Open →'}
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-16">
      <ToolStackMap />
    </div>

    <div class="mt-14 rounded-3xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/10 via-neutral-900/40 to-neutral-950 p-8 text-center sm:p-10">
      <h2 class="text-xl font-semibold text-neutral-100">Ready for a human pass?</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-neutral-400">
        Free consult — we name the bottleneck and the smallest useful next step. Or run a Nemo visibility score first.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <JellyButton href={withBase('/contact#intake')} label="Book a free consult" />
        <JellyButton href={NEMO_SCORE_URL} variant="ghost" label="Free Visibility Audit ↗" external />
        <JellyButton href={withBase('/work')} variant="ghost" label="Browse live demos" />
      </div>
    </div>
  </div>
</BaseLayout>
