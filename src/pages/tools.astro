---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ToolStackMap from '../components/ToolStackMap.astro';
import GatewayCTAs from '../components/GatewayCTAs.astro';
import JellyButton from '../components/JellyButton.astro';
import { ownerTools } from '../data/value-offers';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Owner tools"
  description="Free gateway tools: Spryte homepage audit, Nemo visibility score, lead-leak checklist, module quiz, booking preview, consult roadmap, and pricing bands."
>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeading
      eyebrow="Owner tools"
      title="Useful before you hire anyone"
      subtitle="Start with a free Spryte audit or Nemo visibility score — then use the checklist, quiz, and roadmap if you want to dig deeper. Nothing here requires a sales call."
    />

    <div class="mt-6">
      <GatewayCTAs layout="products" size="sm" />
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        ownerTools.map((card) => (
          <a
            href={card.external ? card.href : withBase(card.href)}
            target={card.external ? '_blank' : undefined}
            rel={card.external ? 'noopener noreferrer' : undefined}
            class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition hover:border-emerald-500/40"
          >
            <h2 class="text-base font-semibold text-neutral-100 group-hover:text-emerald-300">{card.title}</h2>
            <p class="mt-2 text-sm text-neutral-400">{card.body}</p>
            <span class="mt-3 inline-block text-xs font-medium text-emerald-400">
              {card.external ? 'Open ↗' : 'Open →'}
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-16">
      <ToolStackMap />
    </div>

    <div class="mt-14 rounded-3xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/10 via-neutral-900/40 to-neutral-950 p-8 text-center sm:p-10">
      <h2 class="text-xl font-semibold text-neutral-100">Start with a free audit. Decide on a call after.</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-neutral-400">
        No credit card. No auto-enroll. Book a consult only if you want Raymond to walk the score with you.
      </p>
      <div class="mt-6 flex flex-col items-center gap-4">
        <GatewayCTAs layout="full" size="sm" class="justify-center" />
        <JellyButton href={withBase('/work')} variant="ghost" size="sm" label="Browse live demos" />
      </div>
    </div>
  </div>
</BaseLayout>
