---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JellyButton from '../components/JellyButton.astro';
import { pricingBands } from '../data/value-offers';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Pricing & engagement bands"
  description="Clear engagement bands for conversion sites, growth-stack slices, and full lead-to-revenue systems."
>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeading
      eyebrow="Engagements"
      title="Pricing bands, not mystery quotes"
      subtitle="Ranges depend on tools, access, and how messy the current funnel is — these bands show how work usually scopes. Free consult first; no obligation."
    />

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        pricingBands.map((band) => (
          <article
            class:list={[
              'flex flex-col rounded-3xl border p-6 sm:p-7',
              band.featured
                ? 'border-emerald-400/40 bg-gradient-to-br from-emerald-500/10 via-neutral-900/60 to-neutral-950'
                : 'border-neutral-800 bg-neutral-900/40',
            ]}
          >
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">{band.eyebrow}</p>
            <h2 class="mt-2 text-xl font-semibold text-neutral-100">{band.name}</h2>
            <p class="mt-1 text-sm font-medium text-neutral-300">{band.range}</p>
            <p class="mt-1 text-xs text-neutral-500">Typical timeline: {band.timeline}</p>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-neutral-400">{band.summary}</p>

            <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-neutral-500">Includes</p>
            <ul class="mt-2 space-y-1.5 text-sm text-neutral-300">
              {band.includes.map((item) => (
                <li class="flex gap-2">
                  <span class="text-emerald-400">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <p class="mt-4 text-xs text-neutral-500">
              <span class="font-medium text-neutral-400">Not included:</span>{' '}
              {Array.isArray(band.notIncludes) ? band.notIncludes.join(' · ') : band.notIncludes}
            </p>
            <p class="mt-3 text-xs text-neutral-500">
              <span class="font-medium text-neutral-400">Best for:</span> {band.bestFor}
            </p>

            <div class="mt-6">
              <JellyButton
                href={withBase('/contact#intake')}
                size="sm"
                label={band.cta}
                class="w-full justify-center"
              />
            </div>
          </article>
        ))
      }
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-neutral-500">
      Not sure which band fits? Take the{' '}
      <a href={withBase('/quiz')} class="font-medium text-emerald-400 hover:text-emerald-300">module quiz</a>
      {' '}or{' '}
      <a href={withBase('/consult')} class="font-medium text-emerald-400 hover:text-emerald-300">see what a free consult covers</a>.
    </p>
  </div>
</BaseLayout>
